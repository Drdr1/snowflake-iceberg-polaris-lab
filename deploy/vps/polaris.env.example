# Copy to polaris.env (gitignored) and fill in. Never commit the real file.
AWS_REGION=us-east-1
# Keys of the IAM user "polaris-lab-server", which may ONLY assume the
# polaris-iceberg-lab role (aws/polaris-server-user-policy.template.json).
# Polaris assumes that role and vends down-scoped credentials per table.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# realm,client_id,client_secret for the root principal. Use a long random secret.
POLARIS_BOOTSTRAP_CREDENTIALS=POLARIS,root,CHANGE_ME_LONG_RANDOM
